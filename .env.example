SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional — no longer required for auth (tokens are verified via the Supabase Auth API)
SUPABASE_JWT_SECRET=

GROQ_API_KEY=your-groq-key
OPENAI_API_KEY=
LLM_PROVIDER=groq

CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — powers critical-alert emails + recurring report reminders.
# Leave blank to disable notifications entirely (safe default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Set to true to enable the nightly recurring-report-reminder scheduler
# (also runs the ad platform sync sweep and auto-send checks — see below)
ENABLE_SCHEDULER=false

# Token encryption — REQUIRED before connecting any ad platform account.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google Ads (Phase 1 — live). Create an OAuth 2.0 Client ID (Web application)
# in Google Cloud Console, and apply for a standard Google Ads Developer
# Token in your Google Ads account (API Center). No formal app review
# required for read-only reporting access, unlike Meta/TikTok below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta / TikTok — Phase 2/3, not yet implemented (see connector stubs).
# These are config placeholders only; the connectors will raise a clear
# "not yet available" error until each platform's app review is approved
# and the connector methods are filled in.
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
TIKTOK_OAUTH_APP_ID=
TIKTOK_OAUTH_APP_SECRET=
